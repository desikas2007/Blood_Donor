# Copy this file to .env and fill in your real values
# Get all values from: Supabase Dashboard -> Project Settings -> API / Database

# ---- Supabase Postgres (Prisma) ----
# Connection pooler (port 6543) - used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) - used by Prisma CLI for migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Supabase API keys ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

JWT_SECRET="blood-donor-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"
